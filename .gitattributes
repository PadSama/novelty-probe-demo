# 这些文件仍在仓库里，可以浏览与克隆。
/idea export-ignore
/facets export-ignore
/queries export-ignore
/results export-ignore
/evidence export-ignore
/logs export-ignore
/examples export-ignore
/tests export-ignore
/novelty-probe.json export-ignore
